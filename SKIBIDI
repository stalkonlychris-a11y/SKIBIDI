    </span>
  </div>
</div>

<script>
function openConfession() {
  var message = document.getElementById("confession");
  var button = document.getElementById("openBtn");

  if (message.style.display === "block") {
    message.style.display = "none";
    button.innerHTML = "click this to open ♡";
  } else {
    message.style.display = "block";
    button.innerHTML = "close confession ♡";
  }
}
</script>

</body>
</html>
